system/com.apple.kernelmanager_helper = {
	active count = 0
	path = /System/Library/LaunchDaemons/com.apple.kernelmanager_helper.plist
	type = LaunchDaemon
	state = not running

	program = /usr/libexec/kernelmanager_helper
	arguments = {
		/usr/libexec/kernelmanager_helper
	}

	stderr path = /dev/console
	default environment = {
		PATH => /usr/bin:/bin:/usr/sbin:/sbin
	}

	environment = {
		MallocSpaceEfficient => 1
		XPC_SERVICE_NAME => com.apple.kernelmanager_helper
	}

	domain = system
	minimum runtime = 10
	base minimum runtime = 10
	exit timeout = 5
	runs = 0
	last exit code = (never exited)

	endpoints = {
		"com.apple.KernelManagementHelperServer" = {
			port = 0x0
			active = 0
			managed = 1
			reset = 0
			hide = 0
			watching = 1
		}
	}

	spawn type = adaptive (6)
	jetsam priority = 40
	jetsam memory limit (active, soft) = 250 MB
	jetsam memory limit (inactive, soft) = 25 MB
	jetsamproperties category = daemon
	jetsam thread limit = 32
	cpumon = default
	exponential throttling grace limit = 10
	panic on consecutive crashes (0)
	probabilistic guard malloc policy = {
		activation rate = 1/1000
		sample rate = 1/0
	}

	properties = supports transactions | supports pressured exit | inferred program | system service | exponential throttling | tle system
}
