system/com.apple.remoted = {
	active count = 5
	path = /System/Library/LaunchDaemons/com.apple.remoted.plist
	type = LaunchDaemon
	state = running

	program = /usr/libexec/remoted
	arguments = {
		/usr/libexec/remoted
	}

	default environment = {
		PATH => /usr/bin:/bin:/usr/sbin:/sbin
	}

	environment = {
		MallocSpaceEfficient => 1
		MallocStackLoggingDirectory => /private/var/tmp/com.apple.remoted
		PRODUCT_INFO_FILTER_DISABLE => 
		XPC_SERVICE_NAME => com.apple.remoted
	}

	domain = system
	minimum runtime = 10
	base minimum runtime = 10
	exit timeout = 5
	runs = 1
	pid = 113
	immediate reason = speculative
	forks = 0
	execs = 1
	initialized = 1
	trampolined = 1
	started suspended = 0
	proxy started suspended = 0
	last exit code = (never exited)

	semaphores = {
		provides events => 1
	}

	endpoints = {
		"com.apple.remoted.coredevice" = {
			port = 0x5803
			active = 1
			managed = 1
			reset = 0
			hide = 0
			watching = 0
		}
		"com.apple.remoted.compute-platform" = {
			port = 0x7e03
			active = 1
			managed = 1
			reset = 0
			hide = 0
			watching = 0
		}
		"com.apple.remoted.watchdog" = {
			port = 0x7d03
			active = 0
			managed = 1
			reset = 0
			hide = 0
			watching = 0
		}
		"com.apple.remoted.control" = {
			port = 0x5903
			active = 1
			managed = 1
			reset = 0
			hide = 0
			watching = 0
		}
		"com.apple.remoted" = {
			port = 0x5a03
			active = 1
			managed = 1
			reset = 0
			hide = 0
			watching = 0
		}
	}

	spawn type = interactive (4)
	jetsam priority = 180
	jetsam memory limit (active, soft) = 150 MB
	jetsam memory limit (inactive, soft) = 150 MB
	jetsamproperties category = daemon
	jetsam thread limit = 32
	cpumon = default
	resource limits = {
		maxfiles (soft) => 8192
		maxfiles (hard) => 8192
	}

	exponential throttling grace limit = 10
	job state = running
	probabilistic guard malloc policy = {
		activation rate = 1/1000
		sample rate = 1/0
	}

	properties = keepalive | supports transactions | inferred program | system service | exponential throttling | tle system
}
